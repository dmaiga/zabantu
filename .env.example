# --- Application ---
# DEBUG=True  -> SQLite, e-mails en console, pas de HTTPS forcé
# DEBUG=False -> PostgreSQL (DB_* obligatoires), SECRET_KEY obligatoire, cookies sécurisés
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
# Production uniquement :
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# STATIC_ROOT=/chemin/vers/static
# MEDIA_ROOT=/chemin/vers/media

# --- PostgreSQL (production) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- E-mail ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER_MAIN=
EMAIL_HOST_PASSWORD_MAIN=
EMAIL_HOST_USER_NEWS=
EMAIL_HOST_PASSWORD_NEWS=
