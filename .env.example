# --- Application ---
# DEBUG=True  -> e-mails affichés dans la console, pas de HTTPS forcé, clé de développement tolérée
# DEBUG=False -> SECRET_KEY et SITE_URL obligatoires, réglages d'e-mail SMTP obligatoires, cookies sécurisés
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
# Production uniquement :
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Fichiers : statiques (collectstatic) et médias (images, PDF envoyés) ---
# Chemin absolu, ou relatif à la racine du projet.
# Développement : dossiers du projet (valeurs par défaut)
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
# PRODUCTION (hébergement actuel) : à mettre dans le .env du SERVEUR, à la place des deux lignes ci-dessus.
# Ces deux chemins sont obligatoires quand DEBUG=False : le site refuse de démarrer s'ils manquent.
# STATIC_ROOT=/home/cp2594820p30/public_html/static
# MEDIA_ROOT=/home/cp2594820p30/public_html/media

# --- PostgreSQL (développement et production : obligatoire) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- E-mail ---
# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL=
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # par défaut : console si DEBUG=True, SMTP sinon
# En SMTP, tout ce qui suit est obligatoire.

# Compte principal : réponses aux messages, accusés de réception, admissions
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER_MAIN=
EMAIL_HOST_PASSWORD_MAIN=
DEFAULT_FROM_EMAIL=Zabantu <adresse@exemple.org>

# Compte de l'info-lettre : annonces de publications et campagnes
EMAIL_HOST_NEWS=
EMAIL_PORT_NEWS=587
EMAIL_USE_TLS_NEWS=True
EMAIL_USE_SSL_NEWS=False
EMAIL_HOST_USER_NEWS=
EMAIL_HOST_PASSWORD_NEWS=
DEFAULT_FROM_EMAIL_NEWS=Info-lettre Zabantu <adresse@exemple.org>
# SEND_NEWSLETTER_ON_PUBLISH=True   # annoncer automatiquement chaque publication aux abonnés
